# Application
PORT=3000
NODE_ENV=development

# Database (local: host/port — production: DATABASE_URL from Neon, use the direct/non-pooled URL)
# DATABASE_URL=postgresql://user:password@host:5432/fluxera?sslmode=require
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=fluxera
DATABASE_SSL=false

# Redis (local: host/port — production: REDIS_URL from Upstash, rediss://)
# REDIS_URL=rediss://default:password@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT
JWT_SECRET=your-secret-key-min-32-chars-for-production
JWT_EXPIRES_IN=1h

# CORS
CORS_ORIGIN=*

# Swagger
SWAGGER_ENABLED=true
